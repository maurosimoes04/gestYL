<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Auto-updater: corre o deploy.sh periodicamente (LaunchAgent do utilizador) -->
    <key>Label</key>
    <string>com.younglink.gestor-updater</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/maurosimoes/Documents/GESTOR_YL/scripts/deploy.sh</string>
    </array>

    <!-- Verificar a main a cada 5 minutos -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <!-- Logs FORA de ~/Documents (protegido pelo TCC do macOS). -->
    <key>StandardOutPath</key>
    <string>/Users/maurosimoes/Library/Logs/gestor/updater-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/maurosimoes/Library/Logs/gestor/updater-stderr.log</string>
</dict>
</plist>
