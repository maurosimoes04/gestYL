<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Servidor Gestor YL (LaunchAgent do utilizador — sem sudo) -->
    <key>Label</key>
    <string>com.younglink.gestor</string>

    <!-- Corre via /bin/bash (wrapper) para o launchd não ter de executar o node do nvm. -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/USERNAME/Documents/GESTOR_YL/scripts/run-server.sh</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>
    <key>ThrottleInterval</key>
    <integer>5</integer>

    <!-- Logs FORA de ~/Documents (protegido pelo TCC do macOS). -->
    <key>StandardOutPath</key>
    <string>/Users/USERNAME/Library/Logs/gestor/gestor-stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/USERNAME/Library/Logs/gestor/gestor-stderr.log</string>
</dict>
</plist>
