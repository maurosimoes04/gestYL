generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  direcao
  fiscal
}

model Profile {
  id        String   @id @db.Uuid // matches Supabase auth.users.id
  email     String   @unique
  nome      String?
  role      Role     @default(fiscal)
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("profiles")
}

model Evento {
  id           Int       @id @default(autoincrement())
  nome         String
  descricao    String?
  data_inicio  DateTime?
  data_fim     DateTime?
  departamento String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  faturaEventos  FaturaEvento[]
  receitaEventos ReceitaEvento[]
  shares         EventoShare[]

  @@index([departamento])
  @@map("eventos")
}

model Fatura {
  id           Int       @id @default(autoincrement())
  titulo       String
  valor        Decimal   @db.Decimal(10, 2)
  data         DateTime  @db.Date
  departamento String
  tipo         String    @default("Fatura")
  numero       String?
  anexo        Json?
  detalhes     Json?
  analiseIA    Json?
  analiseTentativas Int @default(0)
  estado       String
  descricao    String?
  fornecedor      String?
  fornecedorNif   String?
  dataVencimento  DateTime? @db.Date
  inventarioId Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  inventario    Inventario?    @relation(fields: [inventarioId], references: [id], onDelete: SetNull)
  faturaEventos FaturaEvento[]
  movimento     Movimento?

  @@index([departamento])
  @@index([estado])
  @@index([data])
  @@index([dataVencimento])
  @@map("Faturas")
}

model FaturaEvento {
  id       Int     @id @default(autoincrement())
  faturaId Int
  eventoId Int
  valor    Decimal @db.Decimal(10, 2)

  fatura Fatura @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([faturaId, eventoId])
  @@index([eventoId])
  @@map("fatura_eventos")
}

model Inventario {
  id               Int       @id @default(autoincrement())
  tipo             String
  nome             String
  categoria        String?
  quantidade       Float     @default(0)
  unidade          String?
  localizacao      String?
  estado           String?
  custoUnitario    Float?
  dataAquisicao    DateTime? @db.Date
  dataValidade     DateTime? @db.Date
  quantidadeMinima Float?
  notas            String?
  faturaId         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  faturas Fatura[]

  @@index([estado])
  @@map("inventarios")
}

model Movimento {
  id         Int      @id @default(autoincrement())
  tipo       String
  conta      String
  valor      Decimal  @db.Decimal(10, 2)
  data       DateTime @db.Date
  referencia String?
  descricao  String?
  faturaId   Int?     @unique
  receitaId  Int?     @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  fatura  Fatura?  @relation(fields: [faturaId], references: [id], onDelete: Cascade)
  receita Receita? @relation(fields: [receitaId], references: [id], onDelete: Cascade)

  @@index([data])
  @@map("movimentos")
}

model Receita {
  id           Int      @id @default(autoincrement())
  titulo       String
  valor        Decimal  @db.Decimal(10, 2)
  data         DateTime @db.Date
  categoria    String
  estado       String   @default("Previsto")
  financiador  String?
  anexo        Json?
  observacoes  String?
  analiseIA    Json?
  analiseTentativas Int @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  receitaEventos ReceitaEvento[]
  movimento      Movimento?

  @@index([data])
  @@index([estado])
  @@map("receitas")
}

model ReceitaEvento {
  id        Int     @id @default(autoincrement())
  receitaId Int
  eventoId  Int
  valor     Decimal @db.Decimal(10, 2)

  receita Receita @relation(fields: [receitaId], references: [id], onDelete: Cascade)
  evento  Evento  @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@unique([receitaId, eventoId])
  @@index([eventoId])
  @@map("receita_eventos")
}

model Departamento {
  id        Int      @id @default(autoincrement())
  nome      String   @unique
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("departamentos")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?  @db.Uuid
  email     String?
  action    String   // CREATE, UPDATE, DELETE, LOGIN, LOGOUT, etc.
  entity    String?  // fatura, receita, evento, inventario, movimento, user
  entityId  String?
  details   Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([createdAt])
  @@map("audit_logs")
}

model EventoShare {
  id                     Int       @id @default(autoincrement())
  token                  String    @unique
  eventoId               Int
  createdById            String?   @db.Uuid
  createdByEmail         String?
  destinatario           String?
  justificacao           String
  passwordHash           String
  passwordSalt           String
  accessTokenHash        String?
  accessTokenExpiresAt   DateTime?
  expiresAt              DateTime
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  evento Evento @relation(fields: [eventoId], references: [id], onDelete: Cascade)

  @@index([eventoId])
  @@index([expiresAt])
  @@map("evento_shares")
}
